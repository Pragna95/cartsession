# MongoDB Atlas: replace with your own connection string from Atlas.
MONGO_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=online_cart

# DataStax Astra DB: create an application token and download the Secure Connect Bundle.
ASTRA_TOKEN=YOUR_ASTRA_APPLICATION_TOKEN
ASTRA_SECURE_CONNECT_BUNDLE=./secure-connect-your-database.zip
ASTRA_KEYSPACE=default_keyspace

# Guest session lifetime: 24 hours
SESSION_TTL_SECONDS=86400
